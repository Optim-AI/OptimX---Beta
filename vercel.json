{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/ads/sync?cron=1",
      "schedule": "0 */6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.skalxai.app"
        }
      ],
      "destination": "https://skalxai.app/:path*",
      "statusCode": 308
    }
  ]
}
