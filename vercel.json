{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.skalxai.app"
        }
      ],
      "destination": "https://skalxai.app/:path*",
      "statusCode": 308
    }
  ],
  "crons": [
    {
      "path": "/api/cron/meta-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/monday-brief",
      "schedule": "0,30 * * * *"
    }
  ]
}
