# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Client-side Firebase config (public - exposed to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Server-side Firebase Admin (KEEP SECRET - base64 encoded service account JSON)
# To generate: cat service-account.json | base64
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json_here

# ============================================
# GOOGLE ADS API CONFIGURATION
# ============================================
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-your_client_secret_here
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
# Manager (MCC) account ID for listing/creating campaigns (e.g. 2185924019)
GOOGLE_ADS_MANAGER_ID=your_manager_account_id_here

# ============================================
# DATABASE CONFIGURATION (Drizzle + PostgreSQL)
# ============================================
# Local development - Supabase local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Production - Supabase cloud (copy from your Supabase dashboard):
# DATABASE_URL="postgresql://postgres:your_password@your-host.pooler.supabase.com:6543/postgres"

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Local Development (default keys for 'supabase start')
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Production (copy from your Supabase dashboard > Settings > API):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# ============================================
# STORAGE CONFIGURATION
# ============================================
# Storage is handled by Supabase (both local and production)
# Local: http://localhost:54321/storage/v1
# Production: https://your-project.supabase.co/storage/v1
# Buckets configured in supabase/config.toml:
#   - campaign-assets (public, for campaign images/videos)
#   - user-uploads (public, for user file uploads)

# ============================================
# META/FACEBOOK CONFIGURATION
# ============================================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_API_VERSION=23.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key_here

# ============================================
# APP CONFIGURATION
# ============================================
# Session secret for Iron Session (minimum 32 characters)
SESSION_SECRET=your_random_secret_minimum_32_characters_here

# Integration mode toggle
# Set to 'true' for beta mode (manual form + approval workflow)
# Set to 'false' for full OAuth mode (instant self-service connection)
NEXT_PUBLIC_INTEGRATIONS_BETA_MODE=false

# ============================================
# RAZORPAY CONFIGURATION
# ============================================
# Get these from your Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Public key for frontend checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ============================================
# ADMIN DASHBOARD CONFIGURATION
# ============================================
# Admin credentials for /admin/dashboard access
# IMPORTANT: Change these before deploying to production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# SCHEDULED JOBS CONFIGURATION
# ============================================
# Secret for authenticating cron job requests
CRON_SECRET=your_cron_secret_here

# ============================================
# CREATIVE INTELLIGENCE (Search API)
# ============================================
# For competitor discovery, review mining, Meta Ad Library, Facebook Business Page, and Google Rank Tracking.
# Get from https://www.searchapi.io/
# Used for: Google Search, Meta Ad Library, Meta Ad Library Page Search, Facebook Business Page, Google Rank Tracking
SEARCH_API_KEY=your_search_api_key_here

# ============================================
# CREATIVE STUDIO (Gemini AI)
# ============================================
# Required for script generation. Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Required for video generation (Gemini Veo). Same or separate key.
GEMINI_VEO_API_KEY=your_gemini_veo_api_key_here
# Sora fallback: when Veo fails (quota, rate limit, timeout), use Sora 2. Set to "false" to disable.
VIDEO_SORA_FALLBACK=true

# ============================================
# OPTIONAL/DEBUG CONFIGURATION
# ============================================
DEBUG_CALLBACK=false
